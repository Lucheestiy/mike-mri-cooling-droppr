[Unit]
Description=Reverse SSH tunnel for Droppr VPS bypass
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -R 127.0.0.1:18198:127.0.0.1:8098 root@104.236.97.60
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

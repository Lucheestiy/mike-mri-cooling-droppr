# Optional local host port mapping (container listens on 80).
DROPPR_HOST_PORT=8098

# Credentials for create-share.sh script (optional)
DROPPR_USER=admin
DROPPR_PASSWORD=your_password_here
DROPPR_BASE_URL=https://droppr.coolmri.com
# Optional pre-auth token for scripts/create_upload_request.sh
DROPPR_AUTH_TOKEN=

# Client-side session timeout enforcement (Droppr panel)
# - Idle timeout: logs out after N minutes without activity (0 disables).
# - Max session age: logs out after M minutes regardless of activity (0 disables).
DROPPR_SESSION_ADMIN_IDLE_MINUTES=240
DROPPR_SESSION_USER_IDLE_MINUTES=480
DROPPR_SESSION_ADMIN_MAX_MINUTES=720
DROPPR_SESSION_USER_MAX_MINUTES=1440
DROPPR_SESSION_WARNING_SECONDS=60

# Upload Request notifications (optional webhooks)
# - Comma-separated URLs are supported (POST JSON).
# - If DROPPR_PUBLIC_BASE_URL is set, webhooks include absolute links.
DROPPR_PUBLIC_BASE_URL=
DROPPR_UPLOAD_WEBHOOK_URL=
DROPPR_UPLOAD_WEBHOOK_SECRET=
DROPPR_UPLOAD_WEBHOOK_TIMEOUT_SECONDS=5
DROPPR_UPLOAD_REQUEST_DEFAULT_MAX_FILE_MB=204800
DROPPR_UPLOAD_REQUEST_HARD_MAX_FILE_MB=204800
DROPPR_UPLOAD_SESSION_CHUNK_SIZE_BYTES=16777216
DROPPR_UPLOAD_SESSION_MAX_CHUNK_SIZE_BYTES=67108864
DROPPR_UPLOAD_SESSION_MIN_FREE_BYTES=8589934592
DROPPR_UPLOAD_SESSION_STALE_TTL_SECONDS=2592000
DROPPR_UPLOAD_SESSION_MAX_ACTIVE_PER_REQUEST=16

# Upload processing quality (droppr-faststart)
# - HEVC/H.265 uploads may be transcoded to H.264 for browser compatibility.
# - Lower CRF = higher quality (and larger files).
DROPPR_FASTSTART_X264_PRESET=slow
DROPPR_FASTSTART_X264_CRF=16
DROPPR_FASTSTART_AAC_BITRATE=256k
DROPPR_FASTSTART_COPY_AUDIO=true
DROPPR_FASTSTART_FFMPEG_TIMEOUT_SECONDS=7200
